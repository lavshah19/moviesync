NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# comma-separated; Next.js frontend runs on 3000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=your_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Local: run `docker compose up -d` from project root
MONGODB_URI=mongodb://localhost:27017/moviesync
# Prod (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/moviesync?retryWrites=true&w=majority
