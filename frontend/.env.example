# Copy to .env.local for local development; set the same names on Vercel for production.
# Both have working local defaults, so for `npm run dev` you can leave them unset.

# Where /api/* is proxied to (next.config.ts rewrites). Server-side only, never sent to the browser.
# The backend's base URL: no trailing slash and no /api.
# Local default: http://localhost:3002
BACKEND_URL=http://localhost:3002

# Where the browser opens the Socket.IO connection. It connects to the backend directly,
# because Vercel rewrites don't proxy WebSockets. Usually the same URL as BACKEND_URL.
# NEXT_PUBLIC_ = inlined into the browser bundle at BUILD time: set it on Vercel before deploying.
# The backend's CORS_ORIGIN must include this frontend's URL.
# Local default: http://localhost:3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# Production (Vercel), e.g.:
# BACKEND_URL=https://your-app.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-app.onrender.com
